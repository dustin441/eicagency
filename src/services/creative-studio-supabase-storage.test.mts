import test from 'node:test';import assert from 'node:assert/strict';import {createHash,randomUUID} from 'node:crypto';import {createClient} from '@supabase/supabase-js';import {createSupabaseStudioPrivateStorage} from './creative-studio-supabase-storage.ts';
test('real Supabase SDK uses private create-only upload and byte download through intercepted fetch; no external network',async()=>{
 const png=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jD1sAAAAASUVORK5CYII=','base64');const ownerId=randomUUID();const calls:{url:string;method:string;upsert:string|null}[]=[];
 const client=createClient('https://studio-storage.invalid','unit-test-placeholder-not-a-credential',{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false},global:{fetch:async(input,init)=>{calls.push({url:String(input),method:init?.method??'GET',upsert:new Headers(init?.headers).get('x-upsert')});if(init?.method==='POST')return new Response(JSON.stringify({Key:'synthetic-test-receipt'}),{status:200,headers:{'Content-Type':'application/json'}});return new Response(png,{status:200,headers:{'Content-Type':'image/png'}});}}});
 const store=createSupabaseStudioPrivateStorage({tenantId:'eicagency',ownerId},client);const locator={ownerId,projectId:randomUUID(),versionId:randomUUID(),placementId:'1:1' as const,jobId:randomUUID(),leaseToken:randomUUID()};const meta={sha256:createHash('sha256').update(png).digest('hex'),sizeBytes:png.length,width:1,height:1,mimeType:'image/png' as const};
 await store.upload(locator,png,meta);assert.deepEqual(await store.download(locator,meta),png);assert.equal(calls.length,2);assert.equal(calls[0].method,'POST');assert.equal(calls[0].upsert,'false');for(const call of calls){assert.ok(call.url.includes('/storage/v1/object/creative-studio-private/eicagency/'+ownerId+'/'));assert.equal(call.url.includes('/public/'),false);assert.equal(call.url.includes('/sign/'),false);}
});
