import test from 'node:test';import assert from 'node:assert/strict';
import {createCreativeBuilderServer,CreativeBuilderServerError,type CreativeBuilderServerDependencies} from './creative-builder-server.ts';
const id=(n:number)=>`00000000-0000-4000-8000-${n.toString(16).padStart(12,'0')}`;const project=id(1),scan=id(2),plan=id(3),job=id(4),token=id(5),page=id(6);
const assumption={recommendation:'Source grounded',observedPageExcerptIds:['excerpt-1'],confirmed:false};const claims=[{id:'claim-1',kind:'general' as const,text:'First claim',status:'page-observed' as const,pageExcerptIds:['excerpt-1']},{id:'claim-2',kind:'testimonial' as const,text:'Second claim',status:'needs-confirmation' as const,pageExcerptIds:[]}];const assumptions={advertisedSubject:assumption,offer:assumption,audience:assumption,awareness:assumption,funnelStage:assumption,objective:assumption,message:assumption,cta:assumption,claims};
const receipt={id:scan,scannedAt:'2026-10-16T12:00:00.000Z',pages:[{id:page,kind:'landing' as const,requestedUrl:'https://example.com/',finalUrl:'https://example.com/',title:'Title',description:'Description'}],excerpts:[{id:'excerpt-1',pageId:page,kind:'body' as const,text:'Evidence'}],assets:[],warnings:[]};
const dto={version:1 as const,projectId:project,projectRevision:1,phase:'draft' as const,landingUrl:'https://example.com/',scanId:scan,planRevisionId:plan,assumptions,channels:[],candidates:[],conversation:[]};
function harness(reservationState:'reserved'|'model_started'='reserved'){const calls:string[]=[];let current={...dto};const repository={async create(input:{idempotencyKey:string}){calls.push(`create:${input.idempotencyKey}`);return {projectId:project,revision:0};},async read(){calls.push('read');return current;},async list(){return {projects:[],nextCursor:null,exhausted:true};},async editPlan(input:unknown){calls.push('edit');current={...current,projectRevision:2,assumptions:(input as {assumptions:typeof assumptions}).assumptions};return current;},async confirmPlan(){return current;},async reserveJob(){calls.push('reserve');return {jobId:job,state:reservationState,leaseToken:token,fencingGeneration:1,result:null};},async selectConcept(){return current;},async deleteProject(input:unknown){calls.push('delete');assert.deepEqual(input,{projectId:project,expectedProjectRevision:1});return {project_id:project,state:'pending_objects' as const,enqueued_objects:0,linked_studio_preserved:true};}};const worker={async recover(){calls.push('recover');return {jobId:job,state:'reserved' as const,leaseToken:id(50),fencingGeneration:2,result:null};},async transition(_f:unknown,state:string){calls.push(state);},async commitAnalysis(_f:unknown,input:{scanId:string;receipt:typeof receipt}){calls.push('commit');assert.equal(input.scanId,input.receipt.id);current={...current,scanId:input.scanId};},async commitConcepts(){},async commitRevision(){},async fail(){calls.push('fail');}};const deps={repository,worker,scan:async(_url:string,scanId:string)=>({...receipt,id:scanId}),sources:{async preparePreviews(){calls.push('previews');return [];},async import(){return {assetId:id(20)};}},handoff:{async execute(input:unknown){calls.push('handoff');assert.deepEqual(input,{projectId:project,expectedProjectRevision:1,expectedSelectionId:id(40)});return {handoffKey:'a'.repeat(64),artifactSha256:'b'.repeat(64),projectId:id(41),versionId:id(42)};}},ai:{async analyze(){calls.push('analyze');return {assumptions,channels:[],assistantMessage:'server authored'};},async generate(){throw Error('unused');},async revise(){throw Error('unused');}},uuid:(()=>{let n=2;return()=>id(n++);})()} as unknown as CreativeBuilderServerDependencies;return {server:createCreativeBuilderServer(deps),calls,get current(){return current;}};}
const invalid=(error:unknown)=>error instanceof CreativeBuilderServerError&&error.code==='invalid';
test('create-and-analyze uses one idempotency key for project creation and the fenced job',async()=>{const h=harness();const result=await h.server.execute({operation:'create-and-analyze',url:'https://example.com/'},'analysis:request-1') as typeof dto;assert.equal(result.projectId,project);assert.equal(result.scanId,scan);assert.deepEqual(h.calls,['create:analysis:request-1','reserve','scanning','previews','model_started','analyze','committing','commit','read']);});
test('expired idempotent work is recovered with a newly fenced lease before side effects resume',async()=>{const h=harness('model_started');await h.server.execute({operation:'create-and-analyze',url:'https://example.com/'},'analysis:request-1');assert.deepEqual(h.calls.slice(0,4),['create:analysis:request-1','reserve','recover','scanning']);});
test('create requires a valid replay key before creating a project',async()=>{const h=harness();await assert.rejects(h.server.execute({operation:'create-and-analyze',url:'https://example.com/'}),invalid);assert.deepEqual(h.calls,[]);});
test('browser canonical fields, history, receipts, URLs and object keys are rejected before dependencies',async()=>{for(const extra of [{receipt},{history:[]},{provider:'x'},{model:'x'},{objectKey:'secret'},{scanId:scan}])await assert.rejects(harness().server.execute({operation:'create-and-analyze',url:'https://example.com/',...extra}),invalid);});
test('bounded plan patch is merged with canonical state and stale revision is denied',async()=>{const h=harness();const result=await h.server.execute({operation:'edit-plan',projectId:project,expectedProjectRevision:1,expectedPlanRevisionId:plan,patch:{message:{recommendation:'New message'}}}) as typeof dto;assert.equal(result.assumptions.message.recommendation,'New message');await assert.rejects(h.server.execute({operation:'edit-plan',projectId:project,expectedProjectRevision:1,expectedPlanRevisionId:plan,patch:{message:{recommendation:'Again'}}}),error=>error instanceof CreativeBuilderServerError&&error.code==='conflict');});
test('plan editing may remove claims but cannot add, duplicate, reorder, or change canonical claim identity',async()=>{const kept={id:'claim-2',kind:'testimonial' as const,text:'Keep this exact claim'};const h=harness();const result=await h.server.execute({operation:'edit-plan',projectId:project,expectedProjectRevision:1,expectedPlanRevisionId:plan,patch:{claims:[kept]}}) as typeof dto;assert.deepEqual(result.assumptions.claims,[{...claims[1],text:kept.text,status:'needs-confirmation',pageExcerptIds:[]}]);for(const submitted of [[claims[1],claims[0]],[claims[0],claims[0]],[{...claims[0],id:'new-claim'}],[{...claims[0],kind:'price'}]])await assert.rejects(harness().server.execute({operation:'edit-plan',projectId:project,expectedProjectRevision:1,expectedPlanRevisionId:plan,patch:{claims:submitted}}),invalid);});
test('editing a page-observed general claim clears stale evidence and requires confirmation',async()=>{const edited={id:'claim-1',kind:'general' as const,text:'Now claims a guaranteed result'};const result=await harness().server.execute({operation:'edit-plan',projectId:project,expectedProjectRevision:1,expectedPlanRevisionId:plan,patch:{claims:[edited]}}) as typeof dto;assert.deepEqual(result.assumptions.claims,[{id:'claim-1',kind:'general',text:edited.text,status:'needs-confirmation',pageExcerptIds:[]}]);});
test('revision target unions and selection expected identity are exact',async()=>{const h=harness();await assert.rejects(h.server.execute({operation:'revise',projectId:project,expectedProjectRevision:1,target:'concept',expectedPlanRevisionId:plan,conceptId:'concept-1',message:'x'}),invalid);await assert.rejects(h.server.execute({operation:'select-concept',projectId:project,expectedProjectRevision:1,expectedConceptSetId:id(30),expectedConceptRevisionId:id(31),conceptId:'concept-1',orderedAssetIds:[]}),invalid);});
test('handoff accepts only project revision and selection identity and returns opaque Studio ids',async()=>{const h=harness();const result=await h.server.execute({operation:'handoff',projectId:project,expectedProjectRevision:1,selectionId:id(40)}) as Record<string,unknown>;assert.equal(result.projectId,id(41));assert.deepEqual(h.calls,['handoff']);for(const extra of [{artwork:{}},{canonical:{}},{assetIds:[]},{handoffKey:'x'}])await assert.rejects(h.server.execute({operation:'handoff',projectId:project,expectedProjectRevision:1,selectionId:id(40),...extra}),invalid);});
test('owner deletion accepts only opaque identity and exact project revision',async()=>{const h=harness();const result=await h.server.execute({operation:'delete-project',projectId:project,expectedProjectRevision:1}) as Record<string,unknown>;assert.equal(result.state,'pending_objects');assert.deepEqual(h.calls,['delete']);await assert.rejects(h.server.execute({operation:'delete-project',projectId:project,expectedProjectRevision:1,objectKey:'private'}),invalid);});
