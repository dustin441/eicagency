import test from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {createClient} from '@supabase/supabase-js';import {createHostedStudioRuntime} from './creative-studio-hosted-runtime.ts';import {StudioError} from './creative-studio.ts';
const context={tenantId:'eicagency' as const,ownerId:randomUUID()};
const status=(n:number)=>(e:unknown)=>e instanceof StudioError&&e.status===n;
function dependencies(){let repoCalls=0,workerCalls=0;return{repositoryPool:{connect:async()=>{repoCalls++;throw Error('unit test database unavailable');}},workerPool:{connect:async()=>{workerCalls++;throw Error('must not run worker on list');}},storageClient:createClient('https://studio-storage.invalid','unit-test-placeholder',{auth:{persistSession:false,autoRefreshToken:false},global:{fetch:async()=>{throw Error('must not touch storage for denied/list operations')}}}),counts:()=>[repoCalls,workerCalls]};}
test('default-off runtime rejects before reading capabilities',()=>{const trap=new Proxy({} as ReturnType<typeof dependencies>,{get(){throw Error('capability touched');}});assert.throws(()=>createHostedStudioRuntime({enabled:false,context},trap),status(503));});
test('shared pool rejected and owner mismatch denied without backend operations',async()=>{const d=dependencies();assert.throws(()=>createHostedStudioRuntime({enabled:true,context},{...d,workerPool:d.repositoryPool}),status(503));const service=createHostedStudioRuntime({enabled:true,context},d);await assert.rejects(service.list({userId:randomUUID(),role:'agency'}),status(403));assert.deepEqual(d.counts(),[0,0]);});
test('runtime list uses repository only and sanitizes backend connection failure',async()=>{const d=dependencies();const service=createHostedStudioRuntime({enabled:true,context},d);await assert.rejects(service.list({userId:context.ownerId,role:'agency'}),status(503));assert.deepEqual(d.counts(),[1,0]);});
