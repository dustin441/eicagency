    {
      "id": "f8534a35-a822-49a2-a3eb-8bdbb5513826",
      "name": "Parse Complete Raw Export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json.data != null ? $json.data : ($json.body != null ? $json.body : '');\nconst text = typeof raw === 'string' ? raw : '';\nif (!text.trim()) throw new Error('Marketo export file was empty');\nfunction parseCSV(s) {\n  const rows = []; let i = 0, field = '', row = [], inQ = false;\n  while (i < s.length) {\n    const c = s[i];\n    if (inQ) {\n      if (c === '\"') { if (s[i + 1] === '\"') { field += '\"'; i++; } else inQ = false; }\n      else field += c;\n    } else {\n      if (c === '\"') inQ = true;\n      else if (c === ',') { row.push(field); field = ''; }\n      else if (c === '\\n') { row.push(field); rows.push(row); row = []; field = ''; }\n      else if (c !== '\\r') field += c;\n    }\n    i++;\n  }\n  if (field.length || row.length) { row.push(field); rows.push(row); }\n  return rows;\n}\nconst clean = (v) => {\n  const s = String(v == null ? '' : v).trim();\n  return (s === '' || s.toLowerCase() === 'null' || s.toLowerCase() === 'undefined') ? null : s;\n};\nconst parsed = parseCSV(text);\nif (parsed.length < 1) throw new Error('Marketo export had no CSV header');\nconst header = parsed[0].map(h => h.trim());\nif (!header.includes('id') || !header.includes('updatedAt')) throw new Error('Marketo export missing required id/updatedAt columns');\nconst seen = new Set(); const rows = [];\nfor (let i = 1; i < parsed.length; i++) {\n  const source = parsed[i];\n  if (!source || (source.length === 1 && source[0] === '')) continue;\n  const record = {};\n  header.forEach((name, index) => { record[name] = clean(source[index]); });\n  if (!record.id || !record.updatedAt) continue;\n  if (seen.has(record.id)) throw new Error(`Duplicate Marketo id in smart-list export: ${record.id}`);\n  seen.add(record.id); rows.push(record);\n}\nconst exportId = $('Create Export').item.json.result[0].exportId;\nconst scope = $('Loop Smart Lists').item.json;\nreturn [{json:{\n  payload_json: JSON.stringify({rows, export_id: exportId, window_start: scope.window_start, window_end: scope.window_end}),\n  export_id: exportId,\n  smart_list_id: scope.smartListId,\n  smart_list_name: scope.smartListName,\n  provider_rows: rows.length\n}}];"
      }
    },
    {
      "id": "88b7ce12-ca6d-4b7f-bbc3-e0876db7e56b",
      "name": "Upsert Canonical Raw Contacts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "with payload as (select $1::jsonb p),\nimported as (\n  select public.prepass_large_fleet_import_payload(p) receipt, p from payload\n), logged as (\n  insert into public.prepass_large_fleet_sync_runs(\n    export_id, mode, window_start, window_end, state, provider_rows,\n    qualified_rows, inserted_rows, updated_rows, excluded_rows, provider_status, completed_at\n  )\n  select (p->>'export_id')::uuid, 'snapshot', (p->>'window_start')::timestamptz,\n    (p->>'window_end')::timestamptz, 'completed', jsonb_array_length(p->'rows'),\n    (receipt->>'qualified_rows')::integer, (receipt->>'upserted_rows')::integer,\n    0, (receipt->>'excluded_rows')::integer, receipt, now()\n  from imported\n  on conflict (export_id) do update set state='completed', provider_rows=excluded.provider_rows,\n    qualified_rows=excluded.qualified_rows, inserted_rows=excluded.inserted_rows,\n    excluded_rows=excluded.excluded_rows, provider_status=excluded.provider_status,\n    completed_at=now(), error_code=null, error_message=null\n  returning export_id\n), state_update as (\n  update public.prepass_large_fleet_sync_state\n  set backfill_complete=true,\n      backfill_covered_until=greatest(backfill_covered_until, now()),\n      incremental_covered_until=now(), last_success_at=now(),\n      last_export_id=(select export_id from logged), touched_at=now()\n  where singleton\n  returning singleton\n)\nselect receipt as import_receipt from imported;",
        "options": {
          "queryReplacement": "={{ $json.payload_json }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "e34xAHGHIoRr0Hx6",
