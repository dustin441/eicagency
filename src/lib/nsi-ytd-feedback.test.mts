import test from 'node:test';
import assert from 'node:assert/strict';
import { displayConversions, visibleYtdChannels, fundedYtdSubcampaigns, totalConversions } from './nsi-ytd-presentation.ts';
test('conversion display rounds nearest whole while preserving source totals',()=>{ const r={productSubmittals:10.49,hubspotFormFills:2.51,metaLeads:1};assert.equal(displayConversions(10.49),'10');assert.equal(displayConversions(10.5),'11');assert.equal(displayConversions(1234.5),'1,235');assert.equal(displayConversions(0),'0');assert.equal(displayConversions(null),'Not available');assert.equal(displayConversions(NaN),'Not available');assert.equal(totalConversions(r),14);assert.equal(r.productSubmittals,10.49);});
test('publisher hiding is exact, normalized and presentation-only',()=>{ const rows=['Google Ads','Meta','LinkedIn','tED','EW','EC&M','EC&amp;M','ted conference ads'].map(channel=>({channel,cost:1.25}));assert.deepEqual(visibleYtdChannels(rows).map(r=>r.channel),['Google Ads','Meta','LinkedIn','ted conference ads']);assert.equal(rows.length,8);});
test('subcampaign display requires positive current spend, never prior spend or other activity',()=>{const rows=[{id:'funded',cost:.01,prevCost:0,conversions:2.4},{id:'free-conversions',cost:0,prevCost:5,conversions:10},{id:'prior-only',cost:0,prevCost:9},{id:'inactive',cost:0},{id:'invalid',cost:NaN}];assert.deepEqual(fundedYtdSubcampaigns(rows).map(r=>r.id),['funded']);assert.equal(rows.length,5);assert.equal(rows[0].conversions,2.4);});
